# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/agriconnect
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=2530
SPRING_PROFILES_ACTIVE=dev

# Database Pool / JPA
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10

# Flyway Configuration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number

# Firebase FCM Configuration
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Feature Flags
# Set to true ONLY when Kafka + Schema Registry are running locally
FEATURE_KAFKA_ENABLED=false

# ── Caching Configuration ─────────────────────────────────────────────────────
# Enable/disable Redis/Valkey caching
# Local: false (use Caffeine in-memory cache)
# Production: true (use Valkey/Redis)
CACHE_ENABLED=false

# ── Redis/Valkey Configuration ────────────────────────────────────────────────
# For local development with Redis, or production with AWS ElastiCache Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=default
VALKEY_PASSWORD=your_password
VALKEY_SSL_ENABLED=false

# Connection Pool Settings (optional, defaults provided)
VALKEY_POOL_MAX_ACTIVE=20
VALKEY_POOL_MAX_IDLE=10
VALKEY_POOL_MIN_IDLE=5

# Production Example (AWS ElastiCache Valkey):
#CACHE_ENABLED=true
#VALKEY_HOST=your-cluster.cache.amazonaws.com
#VALKEY_PORT=6379
#VALKEY_PASSWORD=your-auth-token
#VALKEY_SSL_ENABLED=true
