# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/agriconnect
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Server / Environment
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_256_bits
JWT_EXPIRATION=604800000

# Database Pool / JPA
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Flyway (Production-grade migration control)
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
FLYWAY_AUTO_REPAIR_ON_VALIDATION_ERROR=true

# Upload Limits
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=60MB

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5174,http://localhost:1819

# Feature Flags
FEATURE_MOBILE_VERIFICATION_ENABLED=true
# Set to true ONLY when Kafka + Schema Registry are running locally
FEATURE_KAFKA_ENABLED=false

# ── Caching Configuration ─────────────────────────────────────────────────────
# Enable/disable Redis/Valkey caching
# Local: false (use Caffeine in-memory cache)
# Production: true (use Valkey/Redis)
CACHE_ENABLED=false

# ── Redis/Valkey Configuration ────────────────────────────────────────────────
# For local development with Redis (no password needed)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_SSL_ENABLED=false

# Connection Pool Settings (optional, defaults provided)
VALKEY_POOL_MAX_ACTIVE=20
VALKEY_POOL_MAX_IDLE=10
VALKEY_POOL_MIN_IDLE=5

# Production Example (AWS ElastiCache Valkey):
# Only host, port, password (AUTH token), and SSL are needed
#CACHE_ENABLED=true
#VALKEY_HOST=your-valkey-cluster.cache.amazonaws.com
#VALKEY_PORT=6379
#VALKEY_PASSWORD=your-auth-token
#VALKEY_SSL_ENABLED=true
#VALKEY_POOL_MAX_ACTIVE=20
#VALKEY_POOL_MAX_IDLE=10
#VALKEY_POOL_MIN_IDLE=5
